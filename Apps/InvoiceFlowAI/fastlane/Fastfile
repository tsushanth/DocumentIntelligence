default_platform(:ios)

KEY_ID      = "3WHS49Y787"
ISSUER_ID   = "17f51aa8-305f-48b3-acbe-fd8ed3dd5fb6"
KEY_PATH    = File.expand_path("~/private_keys/AuthKey_3WHS49Y787.p8")

platform :ios do
  desc "Build and upload to App Store Connect"
  lane :build_and_submit do
    api_key = app_store_connect_api_key(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      key_filepath: KEY_PATH,
      duration: 1200,
      in_house: false
    )

    gym(
      project: "InvoiceFlowAI.xcodeproj",
      scheme: "InvoiceFlowAI",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store-connect",
        teamID: "7RS696YC75",
        signingStyle: "automatic",
        destination: "upload"
      },
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{KEY_PATH} -authenticationKeyID #{KEY_ID} -authenticationKeyIssuerID #{ISSUER_ID}",
      output_directory: "/tmp/invoiceflowai_build",
      output_name: "InvoiceFlowAI.ipa",
      clean: true
    )
  end
end
