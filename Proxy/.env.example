# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# App API Keys - comma separated (generate your own UUIDs)
# These are keys YOUR apps use to authenticate with this proxy
APP_API_KEYS=docuscan-api-key-uuid,pdfgenius-api-key-uuid,invoiceflow-api-key-uuid

# Allowed Origins (optional, comma separated)
# ALLOWED_ORIGINS=https://yourdomain.com

# Port (Cloud Run sets this automatically)
PORT=8080
